<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>SideData</RootNamespace>
        <LangVersion>latest</LangVersion>
        <CheckEolTargetFramework>false</CheckEolTargetFramework>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    </PropertyGroup>

    <!-- Publish the tests trimmed or as Native AOT to run them there: dotnet publish -f net10.0 -r linux-x64 -p:Mode=trim|aot -->
    <PropertyGroup Condition="'$(Mode)' == 'trim'">
        <PublishTrimmed>true</PublishTrimmed>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Mode)' == 'aot'">
        <PublishAot>true</PublishAot>
    </PropertyGroup>
    <ItemGroup Condition="'$(Mode)' == 'trim'">
        <TrimmerRootAssembly Include="SideData.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" Version="1.78.0"/>
        <PackageReference Include="Bogus" Version="35.6.5"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\SideData\SideData.csproj"/>
    </ItemGroup>

</Project>
